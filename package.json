{
  "name": "forge.editor",
  "version": "1.0.0",
  "description": "In-browser R code editor (CodeMirror 6) with package-aware autocomplete and hover docs.",
  "type": "module",
  "main": "./dist/forge.editor.js",
  "module": "./dist/forge.editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/forge.editor.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:catalog": "Rscript tools/extract-metadata.R"
  },
  "keywords": [
    "r",
    "editor",
    "codemirror",
    "autocomplete"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@codemirror/view": "^6.26.0",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0",
    "vitest": "^2.1.0"
  }
}
